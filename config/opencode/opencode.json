{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {},
  "permission": {
    "bash": {
      "*": "allow",

      "sudo *": "ask",
      "su *": "ask",
      "doas *": "ask",
      "pkexec *": "ask",

      "rm -rf*": "ask",
      "rm -r *": "ask",
      "rm -fr*": "ask",
      "rm -f *": "ask",
      "rmdir *": "ask",
      "chmod -R*": "ask",
      "chown -R*": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shred *": "ask",
      "truncate -s 0 *": "ask",

      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git clean -fd*": "ask",
      "git branch -D *": "ask",

      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "shutdown *": "ask",
      "reboot *": "ask",
      "halt *": "ask",
      "poweroff *": "ask",
      "systemctl stop *": "ask",
      "systemctl disable *": "ask",
      "systemctl enable *": "ask",
      "crontab *": "ask",

      "pip install *": "ask",
      "npm install *": "ask",
      "yarn add *": "ask",
      "pnpm add *": "ask",
      "cargo install *": "ask",
      "go install *": "ask",
      "npx *": "ask",
      "pipx run *": "ask",
      "brew install *": "ask",
      "apt install *": "ask",
      "apt-get install *": "ask",
      "yum install *": "ask",
      "dnf install *": "ask",
      "pacman *": "ask",

      "scp *": "ask",
      "rsync *": "ask",
      "nc *": "ask",
      "ncat *": "ask",
      "socat *": "ask",
      "ssh *": "ask",

      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker system prune*": "ask",
      "docker exec *": "ask",

      "kubectl": "ask",
      "kubectl *": "ask",

      "kubectl get deployment*": "allow",
      "kubectl get pod*": "allow",
      "kubectl get configmap*": "allow",
      "kubectl get service*": "allow",
      "kubectl get svc*": "allow",
      "kubectl get quota*": "allow",
      "kubectl describe deployment*": "allow",
      "kubectl describe pod*": "allow",
      "kubectl describe configmap*": "allow",
      "kubectl describe service*": "allow",
      "kubectl describe svc*": "allow",
      "kubectl describe quota*": "allow",

      "helm uninstall *": "ask",
      "helm rollback *": "ask",
      "terraform destroy *": "ask",
      "terraform apply *": "ask",
      "ansible-playbook *": "ask",

      "curl *-X POST*": "ask",
      "curl *-X PUT*": "ask",
      "curl *-XPOST*": "ask",
      "curl *-XPUT*": "ask",
      "curl *--request POST*": "ask",
      "curl *--request PUT*": "ask",
      "curl *--data*": "ask",
      "curl *-d *": "ask",
      "curl *-T *": "ask",
      "curl *--upload-file*": "ask",
      "wget *--post-data*": "ask",
      "wget *--post-file*": "ask",
      "wget *--upload-file*": "ask",

      "*| sh": "deny",
      "*| bash": "deny",
      "*| zsh": "deny",
      "*|sh": "deny",
      "*|bash": "deny",
      "*|zsh": "deny",
      "*| sh *": "deny",
      "*| bash *": "deny",
      "*| zsh *": "deny",
      "*|sh *": "deny",
      "*|bash *": "deny",
      "*|zsh *": "deny",
      "eval *": "deny",
      "source *": "deny"
    }
  },
  "mcp": {
    "divar-git": {
      "type": "remote",
      "url": "{env:DIVAR_GIT_MCP_URL}",
      "enabled": false
    },
    "divar-jupyter": {
      "type": "remote",
      "url": "{env:DIVAR_JUPYTER_MCP_URL}",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:DIVAR_JUPYTER_MCP_TOKEN}"
      }
    },
    "divar-metabase": {
      "type": "remote",
      "url": "{env:DIVAR_METABASE_MCP_URL}",
      "enabled": false
    },
    "divar-copilot": {
      "type": "remote",
      "url": "{env:DIVAR_COPILOT_MCP_URL}",
      "enabled": false
    },
    "divar-docs": {
      "type": "remote",
      "url": "{env:DIVAR_DOCS_MCP_URL}",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "openscad": {
      "type": "local",
      "command": ["uv", "run", "--with", "git+https://github.com/quellant/openscad-mcp.git", "openscad-mcp"],
      "enabled": false
    }
  },
  "provider": {
    "metisai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "metisai.ir",
      "options": {
        "baseURL": "https://api.metisai.ir/deepseek/v1",
        "apiKey": "{env:METISAI_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "aliafshar/gemma3-it-qat-tools:1b": {
          "name": "gemma3:1b-it-qat"
        }
      }
    },
    "raytoneai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Rayton AI",
      "options": {
        "baseURL": "https://api.raytone.ai/v1",
        "apiKey": "{env:RAYTONEAI_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2"
        },
        "glm-5.3": {
          "name": "glm-5.3"
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Divar LiteLLM",
      "options": {
        "baseURL": "{env:OPENAI_API_BASE}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.2": {
          "name": "gpt-5.2"
        },
        "claude-sonnet-4-5-20251101": {
        "name": "Claude Sonnet 4.5"
        }
      }
    }
  }
}
