    . "$HOME/.cargo/env"
fi

if [ -n "$( command -v goenv )" ]; then
    export GOPATH="$HOME/.local/share/go"
    mkdir -p "$GOPATH"
    export GOENV_ROOT="$HOME/.local/share/goenv"
    mkdir -p "$GOENV_ROOT"
