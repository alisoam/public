# Read-only config/tool trees, disposable state overlays, private tmpfs home,
# allowlisted egress, ssh-agent forwarding when a socket exists.

sd() (
    set -eu

    local project=$PWD
    # Keep whatever predicate the original bwrap wrapper used.
    if [[ ! -d $project || $project == $HOME || $project == / ]]; then
        printf 'Refusing unsafe project directory: %s\n' "$project" >&2
        return 1
    fi

    local sbox_bin=${SBOX_BIN:-sbox}
    local brew_prefix=${HOMEBREW_PREFIX:-/home/linuxbrew/.linuxbrew}
    # sbox forwards the host PATH verbatim; make sure brew + ~/.local/bin are on it.
    local -x PATH="$brew_prefix/bin:$brew_prefix/sbin:$HOME/.local/bin:$PATH"

    # Overlay sources must exist (the bwrap wrapper did the same mkdir -p).
    mkdir -p "$HOME/.cache" \
        "$HOME/.config/zsh" "$HOME/.config/git" "$HOME/.config/nvim" "$HOME/.config/opencode" \
        "$HOME/.local/state/zsh" "$HOME/.local/state/nvim" "$HOME/.local/state/opencode" \
        "$HOME/.local/share/antigen" "$HOME/.local/share/go" "$HOME/.local/share/goenv" \
        "$HOME/.local/share/nvim" "$HOME/.local/share/opencode" "$HOME/.local/bin"

    local -a args
    args=(
        -a git.divar.cloud!private
        -a hekmat.data.divar.cloud!private
        -a mcp-gateway.divar.dev!private
        -a github.com
        -a openai.com
        -a z.ai
        --overlay-mode single
        -r "$brew_prefix"
        -r "$HOME/.local/bin"
        -r "$HOME/.profile"
        -r "$HOME/.zshenv"
        -r "$HOME/.config/zsh"
        -r "$HOME/.config/git"
        -r "$HOME/.config/tmux"
        -r "$HOME/.config/nvim"
        -r "$HOME/.config/opencode"
        --overlay "$HOME/.cache"
        --overlay "$HOME/.local/state/zsh"
        --overlay "$HOME/.local/state/opencode"
        --overlay "$HOME/.local/state/nvim"
        --overlay "$HOME/.local/share/antigen"
        --overlay "$HOME/.local/share/direnv"
        --overlay "$HOME/.local/share/uv"
        --overlay "$HOME/.local/share/go"
        --overlay "$HOME/.local/share/goenv"
        --overlay "$HOME/.local/share/nvim"
        --overlay "$HOME/.local/share/opencode"
        --overlay "$project"
        --env "ZDOTDIR=${ZDOTDIR:-$HOME/.config/zsh}"
        --env SHELL=/bin/zsh
        --env EDITOR=nvim
        --env VISUAL=nvim
        --env "DIVAR_METABASE_MCP_URL=${DIVAR_METABASE_MCP_URL:-''}"
        --env "DIVAR_MCP_URL=${DIVAR_MCP_URL:-''}"
    )

    # git-over-ssh host verification (noninteractive launches fail closed without it).
    if [[ -f $HOME/.ssh/known_hosts ]]; then
        args+=(-r "$HOME/.ssh/known_hosts")
    fi
    # Forwarding an unset host variable is a hard error in sbox — forward only what exists.
    local name
    for name in GOPATH GOENV_ROOT GOENV_SHELL TERMINFO TERMINFO_DIRS COLORTERM; do
        if [[ -v $name ]]; then
            args+=(--env "$name")
        fi
    done
    if [[ -S ${SSH_AUTH_SOCK:-} ]]; then
        args+=(--ssh-agent)
    fi

    # Port-forward passthrough (repeatable), mirrors sbox flags:
    #   -R/--remote-forward SPEC   listen in sandbox, forward to host
    #   -L/--local-forward SPEC    listen on host, forward into sandbox
    # SPEC is [BIND_IP:]PORT:DEST_IP:DEST_PORT (validated by sbox itself).
    while (( $# > 0 )); do
        case $1 in
            -R|--remote-forward)
                if (( $# < 2 )); then
                    printf 'sd: %s requires a SPEC ([BIND:]PORT:DEST:PORT)\n' "$1" >&2
                    return 1
                fi
                args+=(-R "$2")
                shift 2
                ;;
            -L|--local-forward)
                if (( $# < 2 )); then
                    printf 'sd: %s requires a SPEC ([BIND:]PORT:DEST:PORT)\n' "$1" >&2
                    return 1
                fi
                args+=(-L "$2")
                shift 2
                ;;
            --remote-forward=*)
                args+=(-R "${1#*=}")
                shift
                ;;
            --local-forward=*)
                args+=(-L "${1#*=}")
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                printf 'sd: unknown option: %s (put -- before the command if it is part of it)\n' "$1" >&2
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    if (( $# == 0 )); then
        set -- tmux new -A -s sandbox
    fi

    command "$sbox_bin" "${args[@]}" -- /bin/sh -eu -c '
        umask 077
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        exec "$@"
    ' sbox-dev "$@"
)

sbrew() (
  tmpdir=$(mktemp -d) || exit
  chmod 755 "$tmpdir"
  trap 'rm -rf "$tmpdir"' EXIT

  cd "$tmpdir" || exit
  sudo -u linuxbrew -H /home/linuxbrew/.linuxbrew/bin/brew "$@"
)

export KUBE_EDITOR=/bin/vim

alias gdb=gdb-multiarch
alias reset='reset;[ -z "$TMUX" ] || tmux clear-history;'

alias d='docker'
alias dr='docker run'
alias dc='docker compose'
alias dcr='docker compose run --rm -it'
alias dce='docker compose exec -it'
alias v='nvim'
alias o='opencode'
alias k='kubectl'
alias kg='kubectl get'
alias ke='kubectl edit'
alias kl='kubectl logs -f'
alias kgp='kubectl get pod'
alias kgd='kubectl get deployment'
alias kgr='kubectl get rs'
alias kgs='kubectl get sts'
alias kex='kubectl exec -it'
alias grp='grep -nwre'

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

if [ -n "$TMUX" ]; then
  # only for ssh sessions
  session_name=$(tmux display-message -p "#S")
  if [ "${session_name#"ssh-"}" != "$session_name" ]; then
    # Set a trap for SIGHUP to update SSH_AUTH_SOCK
    trap 'export SSH_AUTH_SOCK=$(tmux show-environment SSH_AUTH_SOCK | cut -d= -f2-)' HUP
  fi
fi

function mssh {
  autossh -M 0 $1 ${@:2} -t "tmux new -A -s ssh-${HOST}"
}

function enable_proxy {
    export http_proxy=$PROXY_ADDR
    export HTTP_PROXY=$PROXY_ADDR
    export https_proxy=$PROXY_ADDR
    export HTTPS_PROXY=$PROXY_ADDR
}

function disable_proxy {
    unset http_proxy
    unset HTTP_PROXY
    unset https_proxy
    unset HTTPS_PROXY
}

function mdchrome {
    local tmp
    tmp="$(mktemp --suffix=.html)" || return
    pandoc "$1" -f gfm --mathjax="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml-full.js" -s -o "$tmp" && google-chrome "$tmp"
}

if [ -e "$HOME/.locals" ]; then
    source "$HOME/.locals"
fi
