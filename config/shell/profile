export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

if [ -n "$TMUX" ]; then
  # only for ssh sessions
  session_name=$(tmux display-message -p "#S")
  if [ "${session_name#"ssh-"}" != "$session_name" ]; then
    # Set a trap for SIGHUP to update SSH_AUTH_SOCK
    trap 'export SSH_AUTH_SOCK=$(tmux show-environment SSH_AUTH_SOCK | cut -d= -f2-)' HUP
  fi
fi

function mssh {
  autossh -M 0 $1 ${@:2} -t "tmux new -A -s ssh-${HOST}"
}

function enable_proxy {
    export http_proxy=$PROXY_ADDR
    export HTTP_PROXY=$PROXY_ADDR
    export https_proxy=$PROXY_ADDR
    export HTTPS_PROXY=$PROXY_ADDR
}

function disable_proxy {
    unset http_proxy
    unset HTTP_PROXY
    unset https_proxy
    unset HTTPS_PROXY
}

function mdchrome {
    local tmp
    tmp="$(mktemp --suffix=.html)" || return
    pandoc "$1" -f gfm --mathjax="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml-full.js" -s -o "$tmp" && google-chrome "$tmp"
}

if [ -e "$HOME/.locals" ]; then
    source "$HOME/.locals"
fi
